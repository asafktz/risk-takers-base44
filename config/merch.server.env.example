# Server-only Fourthwall integration. Configure these in Vercel without a
# VITE_ prefix; never copy them into frontend code or commit their values.

# waitlist | private_test | live. Missing or invalid values fail closed to waitlist.
MERCH_MODE=waitlist

# Fourthwall Settings > For Developers > Open API (Basic Auth credentials).
FOURTHWALL_API_USERNAME=
FOURTHWALL_API_PASSWORD=

# Fourthwall Storefront API token and checkout hostname.
FOURTHWALL_STOREFRONT_TOKEN=
FOURTHWALL_SHOP_DOMAIN=risk-takers-shop.fourthwall.com

# Fourthwall webhook configuration secret and current shop ID.
FOURTHWALL_WEBHOOK_SECRET=
FOURTHWALL_SHOP_ID=

# Generate independent random values of at least 32 bytes for these controls.
MERCH_PRIVATE_ACCESS_TOKEN=
MERCH_ADMIN_TOKEN=
